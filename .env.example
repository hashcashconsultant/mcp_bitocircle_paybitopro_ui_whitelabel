# Copy this file to `.env.local` and fill in your own values.
# All NEXT_PUBLIC_* vars are embedded in the client bundle (public by design — no secrets here).

# PayPal checkout (finance-hub). Use your own PayPal app's CLIENT ID (public).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# OPTIONAL — local testing only. Point the BitoCircle services at a local backend.
# Leave UNSET in production (calls then go to the live hosts in src/utils/apiHosts.ts).
# NEXT_PUBLIC_BITOHUB_API_URL=http://localhost:8099
# NEXT_PUBLIC_MONETIZE_API_URL=http://localhost:7099
